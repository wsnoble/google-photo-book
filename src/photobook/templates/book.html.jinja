<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>{{ book_title }}</title>
<style>
  @page {
    size: {{ page_width }} {{ page_height }};
    margin: 0;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
  }
  .page {
    width: {{ page_width }};
    height: {{ page_height }};
    display: flex;
    flex-direction: column;
    break-after: page;
    background: white;
  }
  .page:last-child {
    break-after: auto;
  }
  .row {
    flex: 1;
    display: flex;
    min-height: 0;
  }
  .cell {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0.15in;
  }
  .page.solo .cell {
    padding: 0.3in;
  }
  /* WeasyPrint mis-sizes (overlapping/collapsing columns) an <img> that
     has flex-grow (e.g. `flex: 1`) directly on it once its intrinsic
     size is large (real photos, not small test fixtures). The fix is
     giving flex-grow to this wrapper div instead and sizing the <img>
     with explicit width/height (100%, below) rather than flex-grow --
     object-fit on the <img> itself is fine either way. Do not add
     `flex: 1` (or similar) to `.image-box img` without re-verifying
     against real, large images. */
  .image-box {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .image-box img {
    width: 100%;
    height: 100%;
  }
  /* Grid pages (2+ photos): crop each photo to fill its cell uniformly. */
  .page.grid .image-box img {
    object-fit: cover;
  }
  /* Solo pages (panoramas, and any lone leftover photo): show the full
     frame uncropped -- there's no grid uniformity to preserve. */
  .page.solo .image-box img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .caption {
    text-align: center;
    font-style: italic;
    color: #222;
  }
  .page.solo .caption {
    margin-top: 0.15in;
    font-size: 11pt;
  }
  .page.grid .caption {
    margin-top: 0.05in;
    font-size: 7pt;
  }
</style>
</head>
<body>
{% for page in pages %}
<div class="page {{ 'grid' if page.is_grid else 'solo' }}">
  {% for row in page.rows %}
  <div class="row">
    {% for slot in row %}
    <div class="cell">
      <div class="image-box">
        <img src="{{ slot.image_uri }}" alt="">
      </div>
      {% if slot.caption %}
      <div class="caption">{{ slot.caption }}</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endfor %}
</div>
{% endfor %}
</body>
</html>

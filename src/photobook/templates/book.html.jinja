<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>{{ book_title }}</title>
<style>
  {% include "_fonts.html.jinja" %}
  @page {
    size: {{ page_width_pt }}pt {{ page_height_pt }}pt;
    margin: 0;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: "EB Garamond", Garamond, Georgia, serif;
  }
  .page {
    width: {{ page_width_pt }}pt;
    height: {{ page_height_pt }}pt;
    break-after: page;
    background: white;
  }
  .page:last-child {
    break-after: auto;
  }
  /* Inset from the page edge by bleed + safe margin (conservatively on
     all four sides -- see render.py's _SAFE_AREA_* comment for why) so
     nothing lands where trimming could cut it or the binding could
     obscure it. */
  .safe-area {
    width: calc(100% - {{ safe_area_left_right_pt * 2 }}pt);
    height: calc(100% - {{ safe_area_top_bottom_pt * 2 }}pt);
    margin: {{ safe_area_top_bottom_pt }}pt {{ safe_area_left_right_pt }}pt;
    display: flex;
    flex-direction: column;
  }
  .row {
    flex: 1;
    display: flex;
    min-height: 0;
  }
  .cell {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    padding: 0.15in;
  }
  .page.solo .cell {
    padding: 0.3in;
  }
  /* Every photo is shown at its full frame, uncropped: image-box is sized
     to the photo's exact rendered dimensions under object-fit: contain
     (an inline style computed in render.py._image_box_pt, not CSS)
     rather than stretched to fill the cell, so this centers the
     resulting (image + caption) block as a unit in the available space,
     with any leftover space showing as whitespace around it instead of
     cropping the photo. */
  .photo-block {
    flex: 1;
    min-height: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  /* WeasyPrint doesn't size a plain `width/height: 100%` <img> correctly
     when its parent is `display: flex` -- the img renders at its own
     intrinsic size instead of filling the box (unrelated to the
     already-solved `flex: 1` -on-the-img bug elsewhere in this file: this
     one hits even with no flex properties on the img at all). Taking the
     img out of flow with absolute positioning sidesteps flex-item sizing
     entirely and reliably fills image-box -- verified against real, large
     images; don't revert to plain width/height: 100% without re-checking
     an actual grid page, since small test fixtures alone won't reveal it
     (the intrinsic size becomes visually plausible enough to miss). */
  .image-box {
    position: relative;
    min-height: 0;
    overflow: hidden;
  }
  .image-box img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .caption {
    text-align: center;
    font-style: italic;
    color: #222;
  }
  .page.solo .caption {
    margin-top: 0.15in;
    font-size: 11pt;
  }
  .page.grid .caption {
    margin-top: 0.05in;
    font-size: 7pt;
  }
  .page.chapter .chapter-title-cell {
    align-items: center;
    justify-content: center;
  }
  .chapter-title {
    font-size: 22pt;
    letter-spacing: 0.05em;
    text-align: center;
  }
  .page.title-page .safe-area {
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .title-page-title {
    font-size: 30pt;
    letter-spacing: 0.05em;
    line-height: 1.3;
  }
  .title-page-subtitle {
    margin-top: 0.3in;
    font-size: 16pt;
    font-style: italic;
    color: #444;
  }
</style>
</head>
<body>
{% macro photo_cell(photo) %}
<div class="photo-block">
  <div class="image-box"{% if photo.image_max_width_pt %} style="width: {{ photo.image_max_width_pt }}pt; height: {{ photo.image_max_height_pt }}pt;"{% endif %}>
    <img src="{{ photo.image_uri }}" alt="">
  </div>
  {% if photo.caption %}
  <div class="caption">{{ photo.caption }}</div>
  {% endif %}
</div>
{% endmacro %}
{% for page in pages %}
{% if page.kind == "title" %}
<div class="page title-page">
  <div class="safe-area">
    <div class="title-page-title">
      {% for line in page.title_lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}
    </div>
    {% if page.subtitle %}
    <div class="title-page-subtitle">{{ page.subtitle }}</div>
    {% endif %}
  </div>
</div>
{% elif page.kind == "chapter" %}
<div class="page chapter grid">
  <div class="safe-area">
    <div class="row">
      <div class="cell chapter-title-cell">
        <div class="chapter-title">{{ page.title }}</div>
      </div>
      <div class="cell">
        {% if page.top_photo %}{{ photo_cell(page.top_photo) }}{% endif %}
      </div>
    </div>
    {% if page.panorama %}
    <div class="row">
      <div class="cell">{{ photo_cell(page.panorama) }}</div>
    </div>
    {% else %}
    <div class="row">
      <div class="cell">
        {% if page.bottom_photos|length > 0 %}{{ photo_cell(page.bottom_photos[0]) }}{% endif %}
      </div>
      <div class="cell">
        {% if page.bottom_photos|length > 1 %}{{ photo_cell(page.bottom_photos[1]) }}{% endif %}
      </div>
    </div>
    {% endif %}
  </div>
</div>
{% else %}
<div class="page {{ 'grid' if page.is_grid else 'solo' }}">
  <div class="safe-area">
    {% for row in page.rows %}
    <div class="row">
      {% for slot in row %}
      <div class="cell">{{ photo_cell(slot) }}</div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
</div>
{% endif %}
{% endfor %}
</body>
</html>
